#!/usr/bin/env bash
#
# install_prometheus.sh — install Prometheus on the monitoring server.
#
# Structured as one function per step, orchestrated by main() at the bottom.
# Every function is independently callable, so you can source this file and run
# a single step while debugging:
#
#   source ./install_prometheus.sh --source-only
#   detect_version
#   validate_config
#   check_rule_metrics
#
#   Step 1   update the package index
#   Step 2   install wget / curl / tar
#   Step 3   create the prometheus system user
#   Step 4   detect the latest release
#   Step 5   create /usr/src/prometheus and download into it, resuming if flaky
#   Step 6   extract
#   Step 7   create /etc/prometheus, /etc/prometheus/rules and /var/lib/prometheus
#   Step 8   install the binaries (and consoles, if the release ships them)
#   Step 9   write prometheus.yml
#   Step 10  write the five alert rule files into /etc/prometheus/rules
#   Step 11  set ownership
#   Step 12  write the systemd unit
#   Step 13  promtool check config + check rules
#   Step 14  install nginx and apache2-utils
#   Step 15  create/update the htpasswd file for basic auth
#   Step 16  write the nginx reverse-proxy site and reload
#
# CONFIG LAYOUT: rules live in their own directory and are picked up by a glob,
# so dropping a new file in /etc/prometheus/rules is enough — prometheus.yml
# never has to be edited to add one:
#
#   /etc/prometheus/prometheus.yml
#   /etc/prometheus/rules/fail2ban_rules.yml
#   /etc/prometheus/rules/monit_rules.yml
#   /etc/prometheus/rules/cdr_post_rules.yml
#   /etc/prometheus/rules/claim_agent_rules.yml
#   /etc/prometheus/rules/call_queue_metrics_rules.yml
#
# The glob is also why a stray .yml left in that directory WILL be loaded and
# can stop the service from starting; keep backups outside it (.yml.bak is safe).
#
# MONITORED HOSTS: every exporter job is generated for every --target, each one
# labelled so the same alert can tell the hosts apart. Repeat --target once per
# host, optionally naming it:
#
#   --target 192.168.1.77=Nokia --target 192.168.1.78=Nokia2
#
# Without a name the label value is the IP itself. Targets are asked for
# interactively when none are given.
#
# Exporter ports (override any of them if yours differ):
#   node 9101, nginx 9113, mongodb 9103, redis 9104, freeswitch 9282
#
# The mongodb job is omitted unless --mongodb is passed, since that exporter is
# usually added later; a commented placeholder is written in its place.
#
# Downloads land in /usr/src/prometheus and are KEPT, so a reinstall or
# rollback needs no second download. --uninstall removes that directory too.
#
# ACCESS MODEL: Prometheus binds 127.0.0.1 only -- it has no authentication of
# its own, so exposing :9090 publicly hands anyone your full metric history and
# your infrastructure layout. An nginx reverse proxy adds basic auth in front.
#
# ALWAYS log in through the PROXY port (9091), never 9090. Port 9090 is the
# backend and will open with no password prompt -- by design, which is why it
# is kept on loopback. Two ways in:
#
#   a) SSH tunnel to the proxy (default, nothing exposed):
#        ssh -N -L 9091:127.0.0.1:9091 user@<this-server>
#        then open http://127.0.0.1:9091   (Ctrl-C releases the local port)
#
#   b) Publish the authenticated proxy and browse to it directly:
#        sudo ./install_prometheus.sh --proxy-bind 0.0.0.0
#        then open http://<this-server>:9091  -- it will ask for a password
#
# --bind/--listen-all is refused while the proxy is on: it would put the
# passwordless port on the network and make the login pointless.
#
# Usage:
#   sudo ./install_prometheus.sh
#   sudo ./install_prometheus.sh --target 192.168.1.77=Nokia
#   sudo ./install_prometheus.sh --target 192.168.1.77=Nokia \
#                                --target 192.168.1.78=Nokia2 \
#                                --target 192.168.1.79=Nokia3
#   sudo ./install_prometheus.sh --target 1.2.3.4 --label-name tenant --default-label Telyo
#   sudo ./install_prometheus.sh --target 192.168.1.77=Nokia --mongodb
#   sudo ./install_prometheus.sh --nginx-port 9102          # older exporter port
#   sudo ./install_prometheus.sh --no-alertmanager          # nothing on 9093 yet
#   sudo ./install_prometheus.sh --version 3.6.0 --clean-download
#   sudo ./install_prometheus.sh --proxy-user gagan --proxy-port 9092
#   sudo ./install_prometheus.sh --proxy-bind 0.0.0.0        # browse without a tunnel
#   sudo ./install_prometheus.sh --no-proxy --listen-all     # no auth at all
#
# Uninstall removes the unit, binaries, nginx site, .htpasswd, /etc/prometheus
# (including rules/), /var/lib/prometheus, its downloads and the prometheus user:
#
#   sudo ./install_prometheus.sh --uninstall
#   sudo ./install_prometheus.sh --uninstall --purge-nginx   # also remove nginx
#   sudo ./install_prometheus.sh --uninstall --keep-data --keep-config
#   sudo ./install_prometheus.sh --uninstall --keep-downloads  # keep /usr/src/prometheus
#
set -euo pipefail

# ===========================================================================
# Configuration
# ===========================================================================
REPO="prometheus/prometheus"
# BASH_SOURCE survives `source ./script --source-only`, unlike $0 which becomes "bash".
SCRIPT_NAME="$(basename "${BASH_SOURCE[0]:-$0}")"
SCRIPT_PATH="${BASH_SOURCE[0]:-$0}"
PROMETHEUS_USER="prometheus"
# Prometheus gets its own directory rather than sharing one with the exporter
# installers, so --uninstall can remove it whole without touching their files.
DEFAULT_WORKDIR="/usr/src/prometheus"
WORKDIR="$DEFAULT_WORKDIR"          # tarball, checksum and extracted tree
BIN_DIR="/usr/local/bin"
CONFIG_DIR="/etc/prometheus"
RULES_DIR=""                        # defaults to ${CONFIG_DIR}/rules
DATA_DIR="/var/lib/prometheus"
SERVICE_FILE="/etc/systemd/system/prometheus.service"
PROMETHEUS_PORT="9090"
# Loopback by default: Prometheus has no auth of its own.
BIND_ADDRESS="127.0.0.1"

# nginx reverse proxy with basic auth, also loopback-only.
ENABLE_PROXY=1
# Sits next to Prometheus itself and clear of 8080, which app servers commonly
# claim. Note the Prometheus Pushgateway also defaults to 9091 -- if you ever
# add one here, move this with --proxy-port.
PROXY_PORT="9091"
# Where the AUTHENTICATED proxy listens. 127.0.0.1 = SSH tunnel only.
# Set to 0.0.0.0 (--proxy-bind 0.0.0.0) to reach it from a browser directly.
PROXY_BIND="127.0.0.1"
PROXY_USER="admin"
PROXY_PASSWORD=""
HTPASSWD_FILE="/etc/nginx/.htpasswd"
PROXY_SITE="/etc/nginx/sites-available/prometheus"
PROXY_LINK="/etc/nginx/sites-enabled/prometheus"

VERSION=""                          # empty = detect the latest release

# Monitored hosts. Each element is "IP" or "IP=Label" as typed; normalise_targets
# rewrites the array into "IP|Label" once, after parsing.
TARGETS=()
LABEL_NAME="server"                 # label key attached to every scraped target
DEFAULT_LABEL=""                    # label value for targets given without one
SELF_LABEL="Monitoring-Server"      # label on Prometheus scraping itself

# Where Prometheus sends firing alerts. Empty = no Alertmanager configured.
ALERTMANAGER="127.0.0.1:9093"

# Exporter ports, one per job.
NODE_PORT="9101"
NGINX_PORT="9113"
MONGODB_PORT="9103"
REDIS_PORT="9104"
FREESWITCH_PORT="9282"
ENABLE_MONGODB=0

SCRAPE_INTERVAL="15s"
ALERT_FOR="30s"                     # how long a condition must hold before firing

KEEP_DOWNLOAD=1
SKIP_CHECKSUM=0
UNINSTALL=0
KEEP_DATA=0
KEEP_CONFIG=0
KEEP_DOWNLOADS=0
PURGE_WORKDIR=0
PURGE_NGINX=0
SOURCE_ONLY=0

# This host drops bytes on large transfers, so each pass may only advance part
# of the way; the loop keeps resuming until the archive is complete.
MAX_DOWNLOAD_ATTEMPTS=30

RULE_FILES=(
    "fail2ban_rules.yml"
    "monit_rules.yml"
    "cdr_post_rules.yml"
    "claim_agent_rules.yml"
    "call_queue_metrics_rules.yml"
)

# Metric each rule file keys off, checked after start-up.
RULE_METRICS=(
    "fail2ban_up"
    "monit_up"
    "cdr_post_up"
    "claim_agent_up"
    "call_queue_up"
)

TOTAL_STEPS=16

# Runtime state shared between steps.
ARCHIVE=""; DIRECTORY=""; DOWNLOAD_URL=""; CHECKSUM_URL=""; SUMFILE=""
EXPECTED_SIZE=""

# ===========================================================================
# Output helpers
# ===========================================================================
init_colors() {
    if [ -t 1 ]; then
        C_RESET=$'\033[0m'; C_BLUE=$'\033[1;34m'; C_GREEN=$'\033[1;32m'
        C_YELLOW=$'\033[1;33m'; C_RED=$'\033[1;31m'
    else
        C_RESET=""; C_BLUE=""; C_GREEN=""; C_YELLOW=""; C_RED=""
    fi
}
step()   { printf '\n%s[%s/%s] %s%s\n' "$C_BLUE" "$1" "$TOTAL_STEPS" "$2" "$C_RESET"; }
log()    { printf '\n%s\n' "$*"; }
ok()     { printf '%s  [ok]%s %s\n'   "$C_GREEN"  "$C_RESET" "$*"; }
warn()   { printf '%s  [warn]%s %s\n' "$C_YELLOW" "$C_RESET" "$*"; }
die()    { printf '%s  [fail]%s %s\n' "$C_RED"    "$C_RESET" "$*" >&2; exit 1; }
indent() { sed 's/^/    /'; }
banner() {
    printf '==========================================\n'
    printf ' %s\n' "$1"
    printf '==========================================\n'
}

# ===========================================================================
# Small utilities
# ===========================================================================

# Prints the comment header, stopping at `set -euo pipefail`. Driven off that
# marker rather than fixed line numbers, which go stale whenever the header
# grows and quietly truncate --help.
usage() {
    awk 'NR==1 {next}
         /^set -euo pipefail/ {exit}
         {sub(/^#[[:space:]]?/, ""); print}' "$SCRIPT_PATH"
}

is_number() { case "$1" in ''|*[!0-9]*) return 1 ;; esac; return 0; }

need_arg() { [ -n "${2:-}" ] || die "${1} needs a value."; }

valid_port() {
    is_number "$1" || return 1
    [ "$1" -ge 1 ] && [ "$1" -le 65535 ]
}

valid_ip() {
    # Accepts a bare IPv4 address or IPv4/CIDR. Rejects octets above 255.
    local ip="${1%%/*}" cidr="${1#*/}" o
    case "$1" in
        */*) is_number "$cidr" || return 1
             [ "$cidr" -ge 0 ] && [ "$cidr" -le 32 ] || return 1 ;;
    esac
    case "$ip" in *.*.*.*) ;; *) return 1 ;; esac
    local IFS=.
    set -- $ip
    [ $# -eq 4 ] || return 1
    for o in "$@"; do
        is_number "$o" || return 1
        [ "${#o}" -le 3 ] || return 1
        [ "$o" -le 255 ] || return 1
    done
    return 0
}

# A label value ends up inside single quotes in prometheus.yml, so anything
# that could close the quote or break the line has to be refused here.
valid_label() {
    case "$1" in
        ''|*[!A-Za-z0-9._-]*) return 1 ;;
    esac
    return 0
}

is_private_ip() {
    case "${1%%/*}" in
        10.*|192.168.*|127.*) return 0 ;;
        172.1[6-9].*|172.2[0-9].*|172.3[01].*) return 0 ;;
    esac
    return 1
}

# ===========================================================================
# Monitored hosts
# ===========================================================================

# Rewrites TARGETS from the "IP" / "IP=Label" forms accepted on the command
# line into the single internal "IP|Label" form every later step reads.
normalise_targets() {
    local spec ip label out=()
    for spec in ${TARGETS[@]+"${TARGETS[@]}"}; do
        case "$spec" in
            *=*) ip="${spec%%=*}"; label="${spec#*=}" ;;
            *)   ip="$spec";       label="" ;;
        esac
        valid_ip "$ip" || die "'${ip}' is not a valid IPv4 address (from --target ${spec})."
        [ -n "$label" ] || label="${DEFAULT_LABEL:-$ip}"
        valid_label "$label" \
            || die "Label '${label}' must be letters, digits, dot, dash or underscore."
        out+=("${ip}|${label}")
    done
    TARGETS=(${out[@]+"${out[@]}"})
}

target_ip()    { printf '%s' "${1%%|*}"; }
target_label() { printf '%s' "${1##*|}"; }

prompt_targets() {
    local answer ip label attempt
    log "Monitored servers"
    cat <<EOF
    One entry per host running the exporters (node, nginx, mongodb, redis,
    freeswitch). Prometheus must be able to REACH each one from THIS server —
    a 192.168.x address only works if this host is on the same LAN, VPN or
    has a port-forward to it.

    Give an IP, then an optional short name used as the '${LABEL_NAME}' label
    (Nokia, Nokia2, ...). Press Enter on an empty IP when you are done.

    Verify afterwards with:
      curl -s http://<that-ip>:${NODE_PORT}/metrics | head -1
EOF
    while :; do
        attempt=0
        while [ "$attempt" -lt 3 ]; do
            attempt=$((attempt + 1))
            printf '    Server IP (%s so far, Enter to finish): ' "${#TARGETS[@]}"
            read -r answer || answer=""
            ip="$(printf '%s' "$answer" | tr -d '[:space:]')"
            if [ -z "$ip" ]; then
                [ "${#TARGETS[@]}" -gt 0 ] && return 0
                warn "At least one monitored server is required."
                continue
            fi
            valid_ip "$ip" && break
            warn "'${ip}' is not a valid IPv4 address (attempt ${attempt} of 3)."
            ip=""
        done
        [ -n "$ip" ] || die "No valid address after 3 attempts."

        printf '    Name for %s (Enter to use the IP): ' "$ip"
        read -r answer || answer=""
        label="$(printf '%s' "$answer" | tr -d '[:space:]')"
        [ -n "$label" ] || label="${DEFAULT_LABEL:-$ip}"
        if ! valid_label "$label"; then
            warn "Label '${label}' is not usable; using ${ip} instead."
            label="$ip"
        fi
        TARGETS+=("${ip}|${label}")
        ok "Added ${ip} (${LABEL_NAME}: ${label})"
    done
}

ask_targets() {
    if [ "${#TARGETS[@]}" -gt 0 ]; then
        local spec
        for spec in "${TARGETS[@]}"; do
            ok "Monitored: $(target_ip "$spec") (${LABEL_NAME}: $(target_label "$spec"))"
        done
        return 0
    fi
    [ -t 0 ] || die "No --target given and no terminal to ask on."
    prompt_targets
}

# ===========================================================================
# Argument parsing and preflight
# ===========================================================================

parse_args() {
    while [ $# -gt 0 ]; do
        case "$1" in
            --target|--target-ip)
                              need_arg "$1" "${2:-}"; TARGETS+=("$2"); shift 2 ;;
            --label-name)     need_arg "$1" "${2:-}"; LABEL_NAME="$2"; shift 2 ;;
            --default-label)  need_arg "$1" "${2:-}"; DEFAULT_LABEL="$2"; shift 2 ;;
            # Kept for compatibility with the earlier tenant-labelled config.
            --tenant)         need_arg "$1" "${2:-}"; LABEL_NAME="tenant"; DEFAULT_LABEL="$2"; shift 2 ;;
            --self-label)     need_arg "$1" "${2:-}"; SELF_LABEL="$2"; shift 2 ;;
            --alertmanager)   need_arg "$1" "${2:-}"; ALERTMANAGER="$2"; shift 2 ;;
            --no-alertmanager) ALERTMANAGER=""; shift ;;
            --node-port)      need_arg "$1" "${2:-}"; NODE_PORT="$2"; shift 2 ;;
            --nginx-port)     need_arg "$1" "${2:-}"; NGINX_PORT="$2"; shift 2 ;;
            --mongodb-port)   need_arg "$1" "${2:-}"; MONGODB_PORT="$2"; ENABLE_MONGODB=1; shift 2 ;;
            --redis-port)     need_arg "$1" "${2:-}"; REDIS_PORT="$2"; shift 2 ;;
            --freeswitch-port) need_arg "$1" "${2:-}"; FREESWITCH_PORT="$2"; shift 2 ;;
            --mongodb)        ENABLE_MONGODB=1; shift ;;
            --scrape-interval) need_arg "$1" "${2:-}"; SCRAPE_INTERVAL="$2"; shift 2 ;;
            --alert-for)      need_arg "$1" "${2:-}"; ALERT_FOR="$2"; shift 2 ;;
            --version)        need_arg "$1" "${2:-}"; VERSION="$2"; shift 2 ;;
            --port)           need_arg "$1" "${2:-}"; PROMETHEUS_PORT="$2"; shift 2 ;;
            --bind)           need_arg "$1" "${2:-}"; BIND_ADDRESS="$2"; shift 2 ;;
            --listen-all)     BIND_ADDRESS=""; shift ;;
            --proxy-port)     need_arg "$1" "${2:-}"; PROXY_PORT="$2"; shift 2 ;;
            --proxy-bind)     need_arg "$1" "${2:-}"; PROXY_BIND="$2"; shift 2 ;;
            --proxy-user)     need_arg "$1" "${2:-}"; PROXY_USER="$2"; shift 2 ;;
            --no-proxy)       ENABLE_PROXY=0; shift ;;
            --workdir)        need_arg "$1" "${2:-}"; WORKDIR="$2"; shift 2 ;;
            --config-dir)     need_arg "$1" "${2:-}"; CONFIG_DIR="$2"; shift 2 ;;
            --rules-dir)      need_arg "$1" "${2:-}"; RULES_DIR="$2"; shift 2 ;;
            --data-dir)       need_arg "$1" "${2:-}"; DATA_DIR="$2"; shift 2 ;;
            --skip-checksum)  SKIP_CHECKSUM=1; shift ;;
            --clean-download) KEEP_DOWNLOAD=0; shift ;;
            --keep-data)      KEEP_DATA=1; shift ;;
            --keep-downloads) KEEP_DOWNLOADS=1; shift ;;
            --purge-workdir)  PURGE_WORKDIR=1; shift ;;
            --keep-config)    KEEP_CONFIG=1; shift ;;
            --purge-nginx)    PURGE_NGINX=1; shift ;;
            --purge-data)     shift ;;   # now the default; accepted for compatibility
            --uninstall)      UNINSTALL=1; shift ;;
            --source-only)    SOURCE_ONLY=1; shift ;;
            -h|--help)        usage; exit 0 ;;
            *) die "Unknown option: $1 (try --help)" ;;
        esac
    done

    # --rules-dir defaults to a subdirectory of whatever --config-dir ended up
    # being, so overriding only --config-dir keeps the two together.
    [ -n "$RULES_DIR" ] || RULES_DIR="${CONFIG_DIR}/rules"

    valid_port "$PROMETHEUS_PORT" || die "--port must be a port number (got '$PROMETHEUS_PORT')."
    valid_port "$PROXY_PORT" || die "--proxy-port must be a port number (got '$PROXY_PORT')."
    local p
    for p in "$NODE_PORT" "$NGINX_PORT" "$MONGODB_PORT" "$REDIS_PORT" "$FREESWITCH_PORT"; do
        valid_port "$p" || die "Exporter port '$p' is not a valid port number."
    done
    [ "$PROXY_PORT" != "$PROMETHEUS_PORT" ] \
        || die "--proxy-port and --port cannot both be ${PROXY_PORT}."
    valid_label "$LABEL_NAME" || die "--label-name must be alphanumeric (got '$LABEL_NAME')."
    valid_label "$SELF_LABEL" || die "--self-label must be alphanumeric (got '$SELF_LABEL')."
    [ -z "$DEFAULT_LABEL" ] || valid_label "$DEFAULT_LABEL" \
        || die "--default-label must be alphanumeric (got '$DEFAULT_LABEL')."
    case "$SCRAPE_INTERVAL" in *[!0-9smhd]*|'') die "--scrape-interval looks wrong: '$SCRAPE_INTERVAL' (try 15s)." ;; esac
    case "$ALERT_FOR" in *[!0-9smhd]*|'') die "--alert-for looks wrong: '$ALERT_FOR' (try 30s)." ;; esac
    if [ -n "$ALERTMANAGER" ]; then
        case "$ALERTMANAGER" in
            *:*) valid_port "${ALERTMANAGER##*:}" \
                     || die "--alertmanager '${ALERTMANAGER}' has no valid port." ;;
            *)   die "--alertmanager needs host:port (got '${ALERTMANAGER}')." ;;
        esac
    fi
    case "$PROXY_USER" in
        *[!A-Za-z0-9._-]*|'') die "--proxy-user must be alphanumeric (got '$PROXY_USER')." ;;
    esac
    if [ -n "$BIND_ADDRESS" ]; then
        valid_ip "$BIND_ADDRESS" || die "--bind '$BIND_ADDRESS' is not a valid IPv4 address."
    fi
    valid_ip "$PROXY_BIND" || die "--proxy-bind '$PROXY_BIND' is not a valid IPv4 address."
    # Prometheus itself has NO authentication. If it is reachable from the
    # network, the nginx basic-auth proxy protects nothing -- anyone can just
    # ask port ${PROMETHEUS_PORT} directly. Refuse that combination outright.
    if [ "$ENABLE_PROXY" -eq 1 ] && [ "$BIND_ADDRESS" != "127.0.0.1" ]; then
        die "$(printf '%s\n' \
            "--bind ${BIND_ADDRESS:-0.0.0.0} exposes Prometheus on the network, and Prometheus has no" \
            "      authentication of its own -- the nginx password would be trivially bypassed by" \
            "      opening port ${PROMETHEUS_PORT} directly." \
            "" \
            "      To reach Prometheus from a browser WITH a password, leave it on loopback and" \
            "      publish the authenticated proxy instead:" \
            "          sudo ./${SCRIPT_NAME} --proxy-bind 0.0.0.0" \
            "" \
            "      To expose Prometheus with no password at all (not recommended), be explicit:" \
            "          sudo ./${SCRIPT_NAME} --bind ${BIND_ADDRESS:-0.0.0.0} --no-proxy")"
    fi
    normalise_targets
    VERSION="${VERSION#v}"
    return 0
}

# Something already bound to PROXY_PORT is the single most common reason the
# login never appears: nginx cannot bind it, keeps its OLD config on reload
# (reload still exits 0!), and the other service answers the probe with 200.
port_in_use() {
    # NOTE: do not pipe ss straight into `grep -q`. grep -q exits on first match,
    # SIGPIPEs ss, and `set -o pipefail` then reports the pipeline as failed --
    # i.e. a busy port looks free, intermittently. Capture, then match.
    local out
    out="$(ss -tuln 2>/dev/null || true)"
    case "$out" in *":${1} "*) return 0 ;; esac
    return 1
}

# Walk upward from the requested port and return the first one nothing holds,
# so the error message names a port that will actually work.
suggest_free_port() {
    local candidate="$1" limit=$((${1} + 40))
    while [ "$candidate" -le "$limit" ]; do
        candidate=$((candidate + 1))
        [ "$candidate" = "$PROMETHEUS_PORT" ] && continue
        port_in_use "$candidate" || { printf '%s' "$candidate"; return 0; }
    done
    printf '%s' ""
}

check_proxy_port_free() {
    [ "$ENABLE_PROXY" -eq 1 ] || return 0
    command -v ss >/dev/null 2>&1 || return 0
    local holder free
    holder="$(ss -tulnp 2>/dev/null | grep ":${PROXY_PORT} " | head -1 || true)"
    [ -n "$holder" ] || return 0
    printf '%s\n' "$holder" | tr -s ' ' | cut -c1-120 | indent
    printf '%s' "$holder" | grep -q 'nginx' && { ok "Port ${PROXY_PORT} already held by nginx."; return 0; }

    free="$(suggest_free_port "$PROXY_PORT")"
    die "$(printf '%s\n' \
        "Port ${PROXY_PORT} is already in use by the process shown above, which is not nginx." \
        "      nginx would fail to bind it and silently keep serving its old config, so the" \
        "      login page would never appear -- that other service would answer instead." \
        "" \
        "      Re-run on a free port:" \
        "          sudo ./${SCRIPT_NAME} --proxy-port ${free:-<free-port>}" \
        "" \
        "      Then reach the login at http://127.0.0.1:${free:-<free-port>} through the tunnel:" \
        "          ssh -N -L ${free:-<free-port>}:127.0.0.1:${free:-<free-port>} <user>@<this-server>")"
}

# Prometheus binding a taken port fails at start with a less obvious error, so
# check it here too rather than at systemctl time.
check_prometheus_port_free() {
    command -v ss >/dev/null 2>&1 || return 0
    local holder
    holder="$(ss -tulnp 2>/dev/null | grep ":${PROMETHEUS_PORT} " | head -1 || true)"
    [ -n "$holder" ] || return 0
    printf '%s' "$holder" | grep -q 'prometheus' && { ok "Port ${PROMETHEUS_PORT} already held by Prometheus."; return 0; }
    printf '%s\n' "$holder" | tr -s ' ' | cut -c1-120 | indent
    die "Port ${PROMETHEUS_PORT} is in use by the process above. Re-run with --port <free-port>."
}

check_root() {
    [ "$(id -u)" -eq 0 ] || die "Please run as root:  sudo bash $0"
    command -v systemctl >/dev/null 2>&1 || die "systemd required; systemctl not found."
}

# ===========================================================================
# Uninstall
# ===========================================================================

# Is nginx serving anything besides our proxy site? Purging the package would
# take those down with it, so this decides whether removal is safe.
nginx_has_other_sites() {
    local f
    for f in /etc/nginx/sites-enabled/* /etc/nginx/conf.d/*.conf; do
        [ -e "$f" ] || continue
        [ "$f" = "$PROXY_LINK" ] && continue
        case "$f" in */default) continue ;; esac
        return 0
    done
    return 1
}

remove_nginx_bits() {
    if [ -e "$PROXY_LINK" ] || [ -f "$PROXY_SITE" ]; then
        rm -f "$PROXY_LINK" "$PROXY_SITE"
        ok "Removed the nginx proxy site."
    fi
    if [ -f "$HTPASSWD_FILE" ]; then
        rm -f "$HTPASSWD_FILE"
        ok "Removed ${HTPASSWD_FILE}."
    fi

    if [ "$PURGE_NGINX" -eq 1 ]; then
        if nginx_has_other_sites; then
            warn "Other nginx sites are still enabled — purging the package would break them."
            warn "Kept nginx. Remove those sites first, then re-run with --purge-nginx."
        else
            systemctl disable --now nginx >/dev/null 2>&1 || true
            if command -v apt-get >/dev/null 2>&1; then
                DEBIAN_FRONTEND=noninteractive apt-get purge -y nginx nginx-common nginx-core apache2-utils >/dev/null 2>&1 || true
                DEBIAN_FRONTEND=noninteractive apt-get autoremove -y >/dev/null 2>&1 || true
            fi
            rm -rf /etc/nginx
            ok "Purged nginx and apache2-utils."
        fi
    elif command -v nginx >/dev/null 2>&1; then
        # Reload so the removed site stops being served, but leave the package:
        # other things on this box may depend on it.
        nginx -t >/dev/null 2>&1 && systemctl reload nginx >/dev/null 2>&1 || true
        warn "Kept the nginx package (pass --purge-nginx to remove it too)."
    fi
}

# /usr/src/prometheus belongs to this script alone, so it is removed whole. A
# custom --workdir might be shared with something else, so that case removes
# only our own files and takes the directory only if nothing else remains.
remove_downloads() {
    if [ "$KEEP_DOWNLOADS" -eq 1 ]; then
        warn "Kept ${WORKDIR} (--keep-downloads)."
        return 0
    fi
    [ -d "$WORKDIR" ] || return 0

    if [ "$WORKDIR" = "$DEFAULT_WORKDIR" ] || [ "$PURGE_WORKDIR" -eq 1 ]; then
        rm -rf "${WORKDIR:?}"
        ok "Removed ${WORKDIR} (tarball, checksum and extracted tree)."
        return 0
    fi

    # Custom --workdir only: prometheus* catches the tarball, the extracted dir and any stray
    # partial download. The exporters are named node_exporter*, redis_exporter*
    # and so on, so this glob cannot reach them.
    rm -rf "${WORKDIR:?}"/prometheus* \
           "${WORKDIR:?}"/sha256sums-prometheus-*.txt 2>/dev/null || true
    ok "Removed the Prometheus downloads from ${WORKDIR}."

    # rmdir only succeeds on an empty directory, which is exactly the test we want.
    if rmdir "$WORKDIR" 2>/dev/null; then
        ok "Removed ${WORKDIR} (it was empty)."
    else
        local left
        left="$(ls -A "$WORKDIR" 2>/dev/null | tr '\n' ' ')"
        warn "Kept ${WORKDIR} — it still holds other files:"
        printf '      %s\n' "${left:-<unreadable>}"
        warn "Use --purge-workdir to delete the directory and everything in it."
    fi
}

do_uninstall() {
    banner "Removing Prometheus"
    systemctl disable --now prometheus >/dev/null 2>&1 || true
    rm -f "$SERVICE_FILE" "${BIN_DIR}/prometheus" "${BIN_DIR}/promtool"
    systemctl daemon-reload
    ok "Removed the unit and binaries."

    remove_nginx_bits

    if [ "$KEEP_CONFIG" -eq 1 ]; then
        warn "Kept ${CONFIG_DIR} (--keep-config)."
    else
        # RULES_DIR is usually inside CONFIG_DIR, but --rules-dir may have put it
        # elsewhere, so remove it explicitly rather than assuming.
        rm -rf "$CONFIG_DIR"
        case "$RULES_DIR" in
            "${CONFIG_DIR}"/*) ;;
            *) rm -rf "$RULES_DIR"; ok "Removed ${RULES_DIR}." ;;
        esac
        ok "Removed ${CONFIG_DIR} — prometheus.yml and the rules directory are gone."
    fi

    if [ "$KEEP_DATA" -eq 1 ]; then
        warn "Kept ${DATA_DIR} (--keep-data)."
    else
        rm -rf "$DATA_DIR"
        ok "Removed ${DATA_DIR} — all historical metrics are gone."
    fi

    if id "$PROMETHEUS_USER" >/dev/null 2>&1; then
        userdel "$PROMETHEUS_USER" >/dev/null 2>&1 || true
        groupdel "$PROMETHEUS_USER" >/dev/null 2>&1 || true
        ok "Removed the ${PROMETHEUS_USER} user."
    fi

    remove_downloads
}

# ===========================================================================
# Working directory — created up front, before anything is fetched
# ===========================================================================

create_workdir() {
    log "Preparing ${WORKDIR}"
    mkdir -p "$WORKDIR"
    chmod 0755 "$WORKDIR"
    ok "Downloads will be kept in ${WORKDIR}"
}

# ===========================================================================
# Steps 1-3 — packages and user
# ===========================================================================

update_server() {
    step 1 "Updating the package index..."
    apt-get update -y
}

install_packages() {
    step 2 "Installing required packages..."
    DEBIAN_FRONTEND=noninteractive apt-get install -y wget curl tar
}

create_user() {
    step 3 "Creating the Prometheus user..."
    if id "$PROMETHEUS_USER" >/dev/null 2>&1; then
        ok "User ${PROMETHEUS_USER} already exists."
    else
        # --system keeps the UID below the login range and marks it
        # non-interactive; a plain useradd hands out a normal login UID.
        useradd --system --no-create-home --shell /usr/sbin/nologin "$PROMETHEUS_USER" \
            || die "Could not create the ${PROMETHEUS_USER} user."
        ok "Created."
    fi
    id "$PROMETHEUS_USER" | indent
}

# ===========================================================================
# Step 4 — version
# ===========================================================================

latest_version_via_redirect() {
    # The releases/latest redirect needs no API token and is not rate limited,
    # unlike api.github.com which returns 403 on shared or busy egress IPs.
    curl -fsI -o /dev/null -w '%{redirect_url}' \
        "https://github.com/${REPO}/releases/latest" 2>/dev/null \
        | sed -n 's#.*/tag/v\([0-9][0-9.]*\)$#\1#p' || true
}

latest_version_via_api() {
    curl -fsSL "https://api.github.com/repos/${REPO}/releases/latest" 2>/dev/null \
        | grep '"tag_name":' | head -1 | cut -d '"' -f4 | sed 's/^v//' || true
}

detect_version() {
    step 4 "Detecting the Prometheus version..."

    if [ -n "$VERSION" ]; then
        ok "Using the requested version: ${VERSION}"
    else
        VERSION="$(latest_version_via_redirect)"
        [ -n "$VERSION" ] || {
            warn "Redirect detection failed; trying the GitHub API."
            VERSION="$(latest_version_via_api)"
        }
        [ -n "$VERSION" ] || die "Could not determine the Prometheus version. Pass --version."
        ok "Latest release: ${VERSION}"
    fi

    case "$VERSION" in
        [0-9]*.[0-9]*) ;;
        *) die "Version '${VERSION}' does not look like a release number." ;;
    esac

    ARCHIVE="prometheus-${VERSION}.linux-amd64.tar.gz"
    DIRECTORY="prometheus-${VERSION}.linux-amd64"
    DOWNLOAD_URL="https://github.com/${REPO}/releases/download/v${VERSION}/${ARCHIVE}"
    CHECKSUM_URL="https://github.com/${REPO}/releases/download/v${VERSION}/sha256sums.txt"
    # Named per release: several installers share ${WORKDIR}, and a plain
    # sha256sums.txt would be overwritten by whichever ran last, leaving a kept
    # tarball paired with the wrong checksum file.
    SUMFILE="sha256sums-prometheus-${VERSION}.txt"
}

# ===========================================================================
# Step 5 — download, with resume
# ===========================================================================

local_size() {
    stat -c%s "${WORKDIR}/${ARCHIVE}" 2>/dev/null || echo 0
}

remote_size() {
    curl -fsIL --connect-timeout 30 "$DOWNLOAD_URL" 2>/dev/null \
        | awk 'BEGIN{IGNORECASE=1} /^content-length:/ {v=$2} END {gsub(/\r/,"",v); print v}'
}

verify_archive() {
    cd "$WORKDIR"
    [ -s "$ARCHIVE" ] || return 1

    local expected actual
    if [ "$SKIP_CHECKSUM" -eq 0 ] && curl -fsSL "$CHECKSUM_URL" -o "$SUMFILE" 2>/dev/null; then
        expected="$(grep -E "[[:space:]]${ARCHIVE}\$" "$SUMFILE" | awk '{print $1}')"
    fi

    if [ -n "${expected:-}" ]; then
        actual="$(sha256sum "$ARCHIVE" | awk '{print $1}')"
        if [ "$expected" = "$actual" ]; then
            ok "SHA256 checksum OK."
            return 0
        fi
        warn "Checksum mismatch (expected ${expected}, got ${actual})."
        return 1
    fi

    # A truncated gzip is the failure this catches when no checksum is
    # available — it is exactly how a half-downloaded archive presents.
    warn "Could not read a published checksum; falling back to a gzip test."
    gzip -t "$ARCHIVE" >/dev/null 2>&1 || return 1
    ok "Archive integrity OK."
    return 0
}

download_attempt() {
    # -C -            resume rather than restart
    # --speed-limit   abort a stalled connection so the loop can resume it
    curl -fL -C - -o "$ARCHIVE" \
        --retry 5 --retry-delay 5 --retry-all-errors \
        --connect-timeout 30 --speed-limit 10000 --speed-time 30 \
        "$DOWNLOAD_URL" || true
}

download_prometheus() {
    step 5 "Downloading Prometheus to ${WORKDIR}..."

    mkdir -p "$WORKDIR"
    chmod 0755 "$WORKDIR"
    cd "$WORKDIR"

    if [ -f "$ARCHIVE" ] && verify_archive; then
        ok "A valid archive is already present; skipping the download."
        return 0
    fi

    # Remove any truncated archive or wget-style duplicate (.1, .2 ...)
    rm -f "$ARCHIVE".[0-9]*

    EXPECTED_SIZE="$(remote_size)"
    if [ -n "$EXPECTED_SIZE" ]; then
        printf '    expected size: %s bytes\n' "$EXPECTED_SIZE"
    else
        warn "Could not read Content-Length; relying on the checksum only."
    fi

    local attempt=0 size prev_size stalls=0
    prev_size="$(local_size)"

    while [ "$attempt" -lt "$MAX_DOWNLOAD_ATTEMPTS" ]; do
        attempt=$((attempt + 1))
        printf '\n    pass %s of %s (from byte %s)...\n' \
            "$attempt" "$MAX_DOWNLOAD_ATTEMPTS" "$(local_size)"

        download_attempt
        size="$(local_size)"
        printf '    now at %s / %s bytes\n' "$size" "${EXPECTED_SIZE:-unknown}"

        # Complete? (by size when known, otherwise trust the checksum)
        if [ -z "$EXPECTED_SIZE" ] || [ "$size" = "$EXPECTED_SIZE" ]; then
            if verify_archive; then
                ok "Download verified."
                return 0
            fi
            if [ -n "$EXPECTED_SIZE" ]; then
                warn "Full size reached but the integrity check failed. Starting over."
                rm -f "$ARCHIVE"
                size=0
            fi
        fi

        # Detect a stall: no forward progress across consecutive passes.
        if [ "$size" -le "$prev_size" ]; then
            stalls=$((stalls + 1))
            [ "$stalls" -lt 3 ] || die "Download stalled at ${size} bytes across 3 passes. Resume is not advancing — fetch the archive elsewhere and copy it to ${WORKDIR}/${ARCHIVE}, then re-run."
        else
            stalls=0
        fi

        prev_size="$size"
        sleep 3
    done

    die "Archive still incomplete after ${MAX_DOWNLOAD_ATTEMPTS} passes ($(local_size)/${EXPECTED_SIZE:-?} bytes)."
}

# ===========================================================================
# Step 6 — extract
# ===========================================================================

extract_prometheus() {
    step 6 "Extracting..."
    cd "$WORKDIR"

    if [ -d "${WORKDIR}/${DIRECTORY}" ]; then
        ok "${DIRECTORY} already extracted."
    else
        # This tarball carries its own versioned directory, so no -C is needed.
        if ! tar -xzf "$ARCHIVE"; then
            rm -rf "$ARCHIVE" "${WORKDIR}/${DIRECTORY}"
            die "Archive is corrupt and has been removed. Re-run to download it again."
        fi
    fi

    [ -f "${WORKDIR}/${DIRECTORY}/prometheus" ] \
        || die "prometheus binary not found in ${DIRECTORY}."
    ls "${WORKDIR}/${DIRECTORY}" | indent
}

# ===========================================================================
# Step 7 — directories
# ===========================================================================

create_directories() {
    step 7 "Creating directories..."
    mkdir -p "$CONFIG_DIR" "$RULES_DIR" "$DATA_DIR"
    ok "${CONFIG_DIR}, ${RULES_DIR} and ${DATA_DIR}"
}

# ===========================================================================
# Step 8 — binaries
# ===========================================================================

install_binaries() {
    step 8 "Installing binaries..."
    cd "${WORKDIR}/${DIRECTORY}"

    # A running binary cannot be overwritten in place.
    if systemctl is-active --quiet prometheus 2>/dev/null; then
        systemctl stop prometheus
        ok "Stopped the running service for the upgrade."
    fi

    install -m 0755 prometheus "${BIN_DIR}/prometheus"
    install -m 0755 promtool   "${BIN_DIR}/promtool"

    # Console templates were dropped from the release tarball in Prometheus
    # 3.x, so only install them when the release actually ships them.
    rm -rf "${CONFIG_DIR}/consoles" "${CONFIG_DIR}/console_libraries"
    if [ -d consoles ] && [ -d console_libraries ]; then
        cp -r consoles console_libraries "${CONFIG_DIR}/"
        ok "Console templates installed."
    else
        ok "This release ships no console templates — skipping."
    fi

    "${BIN_DIR}/prometheus" --version 2>&1 | head -1 | indent
}

# ===========================================================================
# Step 9 — prometheus.yml
# ===========================================================================

# One static_configs block per monitored host, each with its own label, so an
# alert can name the host it came from. A single block listing every target
# would label them all identically.
emit_scrape_job() {
    local job="$1" port="$2" comment="$3" spec first=1
    printf '\n  # %s\n' "$comment"
    printf "  - job_name: '%s'\n" "$job"
    printf '    static_configs:\n'
    for spec in "${TARGETS[@]}"; do
        [ "$first" -eq 1 ] || printf '\n'
        first=0
        printf "      - targets:\n"
        printf "          - '%s:%s'\n" "$(target_ip "$spec")" "$port"
        printf "        labels:\n"
        printf "          %s: '%s'\n" "$LABEL_NAME" "$(target_label "$spec")"
    done
}

emit_alerting_block() {
    printf 'alerting:\n  alertmanagers:\n    - static_configs:\n'
    if [ -n "$ALERTMANAGER" ]; then
        printf "        - targets:\n            - '%s'\n" "$ALERTMANAGER"
    else
        # An empty list is valid and keeps the block in place for later.
        printf '        - targets: []\n'
    fi
}

emit_prometheus_config() {
    printf 'global:\n'
    printf '  scrape_interval: %s\n' "$SCRAPE_INTERVAL"
    printf '  evaluation_interval: %s\n\n' "$SCRAPE_INTERVAL"

    emit_alerting_block

    # A glob, not a list: new rule files are picked up without editing this file.
    printf '\nrule_files:\n'
    printf "  - '%s/*.yml'\n" "$RULES_DIR"

    printf '\nscrape_configs:\n'

    printf '\n  # Prometheus itself\n'
    printf "  - job_name: 'prometheus'\n"
    printf '    static_configs:\n'
    printf "      - targets:\n          - '127.0.0.1:%s'\n" "$PROMETHEUS_PORT"
    printf "        labels:\n          %s: '%s'\n" "$LABEL_NAME" "$SELF_LABEL"

    emit_scrape_job "node_exporter"       "$NODE_PORT"       "Node Exporter"
    emit_scrape_job "nginx_exporter"      "$NGINX_PORT"      "Nginx Exporter"
    emit_scrape_job "redis_exporter"      "$REDIS_PORT"      "Redis Exporter"
    emit_scrape_job "freeswitch_exporter" "$FREESWITCH_PORT" "FreeSWITCH Exporter"

    if [ "$ENABLE_MONGODB" -eq 1 ]; then
        emit_scrape_job "mongodb_exporter" "$MONGODB_PORT" "MongoDB Exporter"
    else
        printf '\n  # MongoDB exporter\n'
        printf '  # Not configured. Re-run with --mongodb (port %s) once it is deployed.\n' \
            "$MONGODB_PORT"
    fi
}

write_prometheus_config() {
    step 9 "Writing prometheus.yml..."

    emit_prometheus_config > "${CONFIG_DIR}/prometheus.yml"
    chmod 0644 "${CONFIG_DIR}/prometheus.yml"
    ok "Wrote ${CONFIG_DIR}/prometheus.yml"

    grep -oE "'[^']+:[0-9]+'" "${CONFIG_DIR}/prometheus.yml" | indent || true

    # Configured but absent is worth saying out loud: Prometheus retries the
    # send every evaluation and fills the journal with connection errors.
    if [ -n "$ALERTMANAGER" ] && command -v ss >/dev/null 2>&1; then
        port_in_use "${ALERTMANAGER##*:}" \
            || warn "Nothing is listening on ${ALERTMANAGER}; alerts will fire but go nowhere until Alertmanager is installed (or use --no-alertmanager)."
    fi
}

# ===========================================================================
# Step 10 — alert rules
# ===========================================================================

# Each rule carries a service label as well as severity, so Alertmanager can
# route on the service without parsing the alert name.
write_service_rule() {
    local file="$1" group="$2" alert="$3" metric="$4" summary="$5" description="$6"
    cat > "${RULES_DIR}/${file}" <<EOF
groups:
  - name: ${group}
    rules:

      - alert: ${alert}
        expr: ${metric} == 0
        for: ${ALERT_FOR}
        labels:
          severity: critical
          service: ${alert}
        annotations:
          summary: "${summary}"
          description: "${description}"
EOF
    chmod 0644 "${RULES_DIR}/${file}"
}

write_alert_rules() {
    step 10 "Writing alert rules into ${RULES_DIR}..."

    write_service_rule "fail2ban_rules.yml" "fail2ban alert" \
        "fail2ban" "fail2ban_up" \
        "fail2ban service status" \
        "If fail2ban service is up then inactive value is 1 otherwise 0."

    write_service_rule "monit_rules.yml" "monit alert" \
        "monit" "monit_up" \
        "monit service status." \
        "If monit service is up then inactive value is 1 otherwise 0."

    write_service_rule "cdr_post_rules.yml" "cdrs_post alert" \
        "cdrs_post" "cdr_post_up" \
        "cdrs_post service status." \
        "If cdrs_post service is up then inactive value is 1 otherwise 0."

    write_service_rule "claim_agent_rules.yml" "claim_agent alert" \
        "claim_agent" "claim_agent_up" \
        "claim_agent service status" \
        "If claim_agent service is up then inactive value is 1 otherwise 0."

    write_service_rule "call_queue_metrics_rules.yml" "call_queue alerts" \
        "call_queue" "call_queue_up" \
        "call_queue service status" \
        "If call_queue service is up then inactive value is 1 otherwise 0."

    local r
    for r in "${RULE_FILES[@]}"; do printf '    %s\n' "${RULES_DIR}/${r}"; done

    # The glob loads every .yml here, including ones this script did not write.
    local extra
    extra="$(cd "$RULES_DIR" 2>/dev/null && ls -1 ./*.yml 2>/dev/null | sed 's#^\./##' || true)"
    for r in $extra; do
        case " ${RULE_FILES[*]} " in
            *" $r "*) ;;
            *) warn "${RULES_DIR}/${r} is not managed by this script but WILL be loaded by the glob." ;;
        esac
    done
}

# ===========================================================================
# Step 11 — permissions
# ===========================================================================

set_permissions() {
    step 11 "Setting permissions..."
    chown -R "${PROMETHEUS_USER}:${PROMETHEUS_USER}" "$CONFIG_DIR" "$RULES_DIR" "$DATA_DIR"
    # The binaries are executed by the service, not written by it, so they stay
    # root-owned; only the config and TSDB need the service account.
    chmod 0755 "${BIN_DIR}/prometheus" "${BIN_DIR}/promtool"
    ls -ld "$CONFIG_DIR" "$RULES_DIR" "$DATA_DIR" | indent
}

# ===========================================================================
# Step 12 — systemd unit
# ===========================================================================

build_exec_flags() {
    # ONE ExecStart line: a blank line from an empty conditional flag would end
    # a backslash continuation and turn later flags into unknown directives.
    printf '%s' "--config.file=${CONFIG_DIR}/prometheus.yml"
    printf '%s' " --storage.tsdb.path=${DATA_DIR}"
    printf '%s' " --web.listen-address=${BIND_ADDRESS}:${PROMETHEUS_PORT}"
    if [ -d "${CONFIG_DIR}/consoles" ] && [ -d "${CONFIG_DIR}/console_libraries" ]; then
        printf '%s' " --web.console.templates=${CONFIG_DIR}/consoles"
        printf '%s' " --web.console.libraries=${CONFIG_DIR}/console_libraries"
    fi
    # Needed for `systemctl reload prometheus` to re-read the config instead of
    # being ignored, which is how a rule edit appears to have had no effect.
    printf '%s' " --web.enable-lifecycle"
    return 0
}

create_service() {
    step 12 "Writing the systemd unit..."

    cat > "$SERVICE_FILE" <<EOF
[Unit]
Description=Prometheus Monitoring
Wants=network-online.target
After=network-online.target

[Service]
User=${PROMETHEUS_USER}
Group=${PROMETHEUS_USER}
Type=simple
ExecStart=${BIN_DIR}/prometheus $(build_exec_flags)
ExecReload=/bin/kill -HUP \$MAINPID
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF

    chmod 0644 "$SERVICE_FILE"
    grep '^ExecStart=' "$SERVICE_FILE" | fold -w 74 -s | indent
    ok "Wrote ${SERVICE_FILE}"
}

# ===========================================================================
# Step 13 — validate
# ===========================================================================

validate_config() {
    step 13 "Validating the configuration..."

    "${BIN_DIR}/promtool" check config "${CONFIG_DIR}/prometheus.yml" | indent \
        || die "promtool rejected prometheus.yml."

    # check config already expands the glob, but checking each file by name
    # points at the offending file directly instead of at the glob.
    log "Validating alert rules..."
    local rule count=0
    for rule in "${RULES_DIR}"/*.yml; do
        [ -e "$rule" ] || continue
        "${BIN_DIR}/promtool" check rules "$rule" | indent \
            || die "promtool rejected ${rule}."
        count=$((count + 1))
    done
    [ "$count" -gt 0 ] || die "No rule files found in ${RULES_DIR}."
    ok "Config and all ${count} rule files are valid."
}

# ===========================================================================
# Service management
# ===========================================================================

start_prometheus() {
    log "Reloading systemd, enabling and starting Prometheus..."
    systemctl daemon-reload
    systemctl enable prometheus >/dev/null 2>&1 || warn "Could not enable at boot."
    systemctl restart prometheus
    sleep 5
}

check_service() {
    log "Checking the service..."
    if systemctl is-active --quiet prometheus; then
        ok "Prometheus is RUNNING."
        return 0
    fi
    warn "Prometheus failed to start."
    systemctl --no-pager -l status prometheus | indent || true
    journalctl -u prometheus --no-pager -n 50 | indent || true
    die "See the log above."
}

check_port() {
    log "Checking port ${PROMETHEUS_PORT}..."
    command -v ss >/dev/null 2>&1 || { warn "ss not available; skipping."; return 0; }
    ss -tulnp 2>/dev/null | grep ":${PROMETHEUS_PORT}" | indent \
        || die "Prometheus is not listening on ${PROMETHEUS_PORT}."
    ok "Listening on ${BIND_ADDRESS:-0.0.0.0}:${PROMETHEUS_PORT}."
}

check_rules_loaded() {
    log "Checking that the rule groups loaded..."
    local out groups
    out="$(curl -fsS "http://localhost:${PROMETHEUS_PORT}/api/v1/rules" 2>/dev/null || true)"
    [ -n "$out" ] || { warn "Could not query the rules API yet."; return 0; }
    groups="$(printf '%s' "$out" | grep -o '"name":"[^"]*"' | wc -l | tr -d ' ')"
    ok "The rules API reports ${groups} named object(s) loaded from ${RULES_DIR}."
    return 0
}

# ===========================================================================
# Post-start sanity: do the alert rules reference metrics that exist?
# ===========================================================================

known_metric_names() {
    # Isolate the JSON array first. Splitting the raw body on commas leaves the
    # first element carrying its {"status":...,"data":[ prefix, so it never
    # matches an exact grep -qx and reads as a missing metric.
    curl -fsS "http://localhost:${PROMETHEUS_PORT}/api/v1/label/__name__/values" 2>/dev/null \
        | sed -n 's/.*"data":\[\(.*\)\].*/\1/p' \
        | tr ',' '\n' | tr -d '"' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' || true
}

check_rule_metrics() {
    # An alert whose metric name never appears can never fire, and Prometheus
    # will not tell you: promtool only checks syntax, not whether the series
    # exists. This is the difference between a silent alert and a working one.
    log "Checking that alert metrics actually exist..."

    local names missing="" m
    names="$(known_metric_names)"
    if [ -z "$names" ]; then
        warn "Could not read the metric list from the API; skipping this check."
        return 0
    fi

    for m in "${RULE_METRICS[@]}"; do
        printf '%s\n' "$names" | grep -qx "$m" \
            && ok "${m} present" \
            || { warn "${m} NOT present — the alert using it can never fire."; missing="${missing} ${m}"; }
    done

    [ -z "$missing" ] && return 0
    warn "Missing:${missing}"
    warn "Either the exporter is not being scraped yet, or the rule names a"
    warn "metric the collector does not emit. Compare against:"
    warn "  curl -s http://localhost:${PROMETHEUS_PORT}/api/v1/label/__name__/values | tr ',' '\\n' | grep -i queue"
    return 0
}

check_targets() {
    log "Checking scrape target health..."
    local out
    out="$(curl -fsS "http://localhost:${PROMETHEUS_PORT}/api/v1/targets" 2>/dev/null || true)"
    [ -n "$out" ] || { warn "Could not query the targets API yet."; return 0; }
    printf '%s' "$out" | grep -o '"health":"[^"]*"' | sort | uniq -c | indent || true
    if printf '%s' "$out" | grep -q '"health":"down"'; then
        warn "Some targets are DOWN — check reachability from THIS host:"
        local spec ip
        for spec in "${TARGETS[@]}"; do
            ip="$(target_ip "$spec")"
            warn "  curl -s http://${ip}:${NODE_PORT}/metrics | head -1"
        done
    else
        ok "No down targets reported."
    fi
    return 0
}

# ===========================================================================
# Downloads
# ===========================================================================

report_downloads() {
    log "Downloaded files"
    if [ "$KEEP_DOWNLOAD" -eq 1 ]; then
        ls -lh "${WORKDIR}/${ARCHIVE}" 2>/dev/null | indent || true
        [ -f "${WORKDIR}/${SUMFILE}" ] && ls -lh "${WORKDIR}/${SUMFILE}" | indent
        ok "Kept in ${WORKDIR} (pass --clean-download to remove)."
    else
        rm -rf "${WORKDIR}/${DIRECTORY}" "${WORKDIR}/${ARCHIVE}"
        ok "Removed the download and extracted directory."
    fi
}

# ===========================================================================
# Summary
# ===========================================================================

print_summary() {
    local server_ip spec
    server_ip="$(hostname -I 2>/dev/null | awk '{print $1}')"

    printf '\n'
    banner "Prometheus Installation Complete"

    printf '  version      : %s\n' "$("${BIN_DIR}/prometheus" --version 2>&1 | head -1 | awk '{print $3}')"
    printf '  config       : %s/prometheus.yml\n' "$CONFIG_DIR"
    printf '  rules        : %s/*.yml\n' "$RULES_DIR"
    printf '  data         : %s\n' "$DATA_DIR"
    printf '  downloads    : %s\n' "$WORKDIR"
    printf '  listen       : %s:%s\n' "${BIND_ADDRESS:-0.0.0.0}" "$PROMETHEUS_PORT"
    printf '  alertmanager : %s\n' "${ALERTMANAGER:-none configured}"
    if [ "$ENABLE_PROXY" -eq 1 ]; then
        printf '  proxy        : %s:%s (basic auth, user %s)\n' "$PROXY_BIND" "$PROXY_PORT" "$PROXY_USER"
    else
        printf '  proxy        : disabled (--no-proxy)\n'
    fi
    # Point at the port that ASKS FOR A PASSWORD. Printing :9090 here is what
    # sends people to the unauthenticated backend and makes the login look broken.
    if [ "$ENABLE_PROXY" -eq 1 ]; then
        if [ "$PROXY_BIND" = "127.0.0.1" ]; then
            printf '  URL          : http://127.0.0.1:%s  (via SSH tunnel — see below)\n' "$PROXY_PORT"
        else
            printf '  URL          : http://%s:%s  (asks for the %s password)\n' \
                "${server_ip:-<this host>}" "$PROXY_PORT" "$PROXY_USER"
        fi
        printf '  NOTE         : port %s is Prometheus itself and has NO password.\n' "$PROMETHEUS_PORT"
        printf '                 It stays on 127.0.0.1 on purpose. Do not open it.\n'
    else
        printf '  URL          : http://%s:%s  (NO authentication — --no-proxy)\n' \
            "${server_ip:-<this host>}" "$PROMETHEUS_PORT"
    fi

    printf '\n  alert rules (for: %s):\n' "$ALERT_FOR"
    local r
    for r in "${RULE_FILES[@]}"; do printf '    %s/%s\n' "$RULES_DIR" "$r"; done

    printf '\n  monitored hosts (%s label):\n' "$LABEL_NAME"
    for spec in "${TARGETS[@]}"; do
        printf '    %-15s %s\n' "$(target_ip "$spec")" "$(target_label "$spec")"
    done

    printf '\n  scrape ports per host:\n'
    printf '    node_exporter        %s\n' "$NODE_PORT"
    printf '    nginx_exporter       %s\n' "$NGINX_PORT"
    printf '    redis_exporter       %s\n' "$REDIS_PORT"
    printf '    freeswitch_exporter  %s\n' "$FREESWITCH_PORT"
    if [ "$ENABLE_MONGODB" -eq 1 ]; then
        printf '    mongodb_exporter     %s\n' "$MONGODB_PORT"
    else
        printf '    mongodb_exporter     not configured (--mongodb)\n'
    fi

    cat <<EOF

  Next:
    /targets   — all should be UP
    /rules     — all five groups loaded
    Add a rule: drop a .yml into ${RULES_DIR}, then
      promtool check rules ${RULES_DIR}/<new>.yml
      systemctl reload prometheus
    Keep backups OUT of that directory — the glob loads every .yml in it.
EOF

    print_tunnel_help
    printf '\n==========================================\n'
}


# ===========================================================================
# Steps 14-16 — nginx reverse proxy with basic auth
# ===========================================================================

ask_proxy_password() {
    # Asked in the interactive phase so the slow download does not sit between
    # the operator and the last prompt.
    [ "$ENABLE_PROXY" -eq 1 ] || return 0

    # An existing entry for this user is reused rather than silently reset.
    if [ -f "$HTPASSWD_FILE" ] && grep -q "^${PROXY_USER}:" "$HTPASSWD_FILE" 2>/dev/null; then
        ok "${PROXY_USER} already exists in ${HTPASSWD_FILE}; keeping that password."
        return 0
    fi

    [ -t 0 ] || die "A proxy password is needed and there is no terminal to ask on. Use --no-proxy, or create ${HTPASSWD_FILE} first."

    log "Basic-auth password for the Prometheus UI"
    printf '    This protects http://127.0.0.1:%s behind nginx.\n' "$PROXY_PORT"
    printf '    User: %s\n' "$PROXY_USER"

    local p1 p2 attempt=0
    while [ "$attempt" -lt 3 ]; do
        attempt=$((attempt + 1))
        printf '    Password (hidden): '; read -rs p1; printf '\n'
        printf '    Confirm:           '; read -rs p2; printf '\n'
        if [ -z "$p1" ]; then
            warn "Empty password (attempt ${attempt} of 3)."
        elif [ "$p1" != "$p2" ]; then
            warn "Passwords do not match (attempt ${attempt} of 3)."
        else
            PROXY_PASSWORD="$p1"
            unset p1 p2
            ok "Password accepted."
            return 0
        fi
    done
    die "No matching password after 3 attempts."
}

install_nginx() {
    [ "$ENABLE_PROXY" -eq 1 ] || return 0
    step 14 "Installing nginx and apache2-utils..."

    if command -v nginx >/dev/null 2>&1; then
        ok "nginx already installed: $(nginx -v 2>&1)"
    else
        DEBIAN_FRONTEND=noninteractive apt-get install -y nginx
    fi
    command -v htpasswd >/dev/null 2>&1 \
        || DEBIAN_FRONTEND=noninteractive apt-get install -y apache2-utils
    command -v htpasswd >/dev/null 2>&1 || die "htpasswd still not available after installing apache2-utils."

    systemctl enable nginx >/dev/null 2>&1 || warn "Could not enable nginx at boot."
    systemctl start nginx >/dev/null 2>&1 || true
    ok "nginx and htpasswd available"
}

write_htpasswd_entry() {
    # -i reads the password from stdin, so it never reaches argv where ps and
    # /proc would expose it. -b would put it on the command line.
    local create_flag="$1"
    printf '%s' "$PROXY_PASSWORD" \
        | htpasswd ${create_flag} -i "$HTPASSWD_FILE" "$PROXY_USER" >/dev/null 2>&1
}

create_htpasswd() {
    [ "$ENABLE_PROXY" -eq 1 ] || return 0
    step 15 "Basic-auth credentials..."

    if [ -f "$HTPASSWD_FILE" ] && grep -q "^${PROXY_USER}:" "$HTPASSWD_FILE" 2>/dev/null; then
        ok "${PROXY_USER} already present; leaving ${HTPASSWD_FILE} untouched."
    elif [ -f "$HTPASSWD_FILE" ]; then
        # NEVER pass -c to an existing file: it truncates, silently deleting
        # every other user already in it.
        write_htpasswd_entry "" || die "htpasswd failed for ${PROXY_USER}."
        ok "Appended ${PROXY_USER} to the existing ${HTPASSWD_FILE}."
    else
        write_htpasswd_entry "-c" || die "htpasswd failed creating ${HTPASSWD_FILE}."
        ok "Created ${HTPASSWD_FILE} with user ${PROXY_USER}."
    fi

    # Readable by nginx's worker user, not by everyone: it holds password
    # hashes that are worth brute-forcing offline.
    chown root:www-data "$HTPASSWD_FILE" 2>/dev/null || chown root:root "$HTPASSWD_FILE"
    chmod 0640 "$HTPASSWD_FILE"
    ls -l "$HTPASSWD_FILE" | indent
    printf '    users: %s\n' "$(cut -d: -f1 "$HTPASSWD_FILE" | tr '\n' ' ')"
    unset PROXY_PASSWORD
}

write_proxy_site() {
    cat > "$PROXY_SITE" <<EOF
# Managed by ${SCRIPT_NAME}
server {
    listen ${PROXY_BIND}:${PROXY_PORT};
    server_name localhost;

    location / {
        proxy_pass http://127.0.0.1:${PROMETHEUS_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;

        auth_basic "Prometheus Login";
        auth_basic_user_file ${HTPASSWD_FILE};
    }
}
EOF
    chmod 0644 "$PROXY_SITE"
}

configure_proxy() {
    [ "$ENABLE_PROXY" -eq 1 ] || { ok "Reverse proxy skipped (--no-proxy)."; return 0; }
    step 16 "nginx reverse proxy on ${PROXY_BIND}:${PROXY_PORT}..."

    write_proxy_site
    ln -sf "$PROXY_SITE" "$PROXY_LINK"
    ok "Linked into sites-enabled."

    nginx -t 2>&1 | indent || die "nginx config test failed — fix the errors above."
    # reload, not restart: a restart drops in-flight connections on a live
    # server that may be serving other sites.
    systemctl reload nginx 2>/dev/null || systemctl restart nginx \
        || die "nginx failed to reload. Check: journalctl -u nginx -n 30"
    sleep 1
    systemctl is-active --quiet nginx || die "nginx is not active."

    # A reload whose new listen directive cannot bind logs an error, returns 0,
    # and leaves the OLD config running. Confirm nginx actually owns the port.
    if command -v ss >/dev/null 2>&1; then
        local holder
        holder="$(ss -tulnp 2>/dev/null | grep ":${PROXY_PORT} " | head -1 || true)"
        if [ -z "$holder" ]; then
            die "nginx reloaded but nothing is listening on ${PROXY_PORT}. Check: journalctl -u nginx -n 30"
        fi
        printf '%s' "$holder" | grep -q 'nginx' \
            || { printf '%s\n' "$holder" | tr -s ' ' | cut -c1-120 | indent
                 die "Port ${PROXY_PORT} is owned by another process, not nginx. Re-run with --proxy-port <free-port>."; }
    fi
    ok "nginx reloaded and owns ${PROXY_PORT}"
}

check_proxy_port() {
    [ "$ENABLE_PROXY" -eq 1 ] || return 0
    command -v ss >/dev/null 2>&1 || return 0
    log "Checking the proxy port ${PROXY_PORT}..."
    ss -tulnp 2>/dev/null | grep ":${PROXY_PORT}" | indent \
        || { warn "Nothing is listening on ${PROXY_PORT}."; return 0; }
    ok "Proxy listening on ${PROXY_BIND}:${PROXY_PORT}"
}

# Called only when the probe came back 200. Our server block puts auth_basic on
# location /, so it CANNOT return 200 unauthenticated -- which means the request
# reached something else. This works out what.
diagnose_proxy_auth() {
    local probe="$1" holder server body
    printf '\n'
    warn "Working out what actually answered on ${probe}:${PROXY_PORT} ..."

    # (a) Who owns the port?
    if command -v ss >/dev/null 2>&1; then
        holder="$(ss -tulnp 2>/dev/null | grep ":${PROXY_PORT} " | head -1 || true)"
        if [ -z "$holder" ]; then
            warn "  - nothing is listening on ${PROXY_PORT} (yet something answered?)"
        else
            printf '      port %s: %s\n' "$PROXY_PORT" "$(printf '%s' "$holder" | tr -s ' ' | cut -c1-110)"
            printf '%s' "$holder" | grep -q nginx \
                || warn "  - CAUSE: that is NOT nginx. Another service owns ${PROXY_PORT}, so nginx never bound it."
        fi
    fi

    # (b) Which server identified itself?
    server="$(curl -sI --max-time 5 "http://${probe}:${PROXY_PORT}/" 2>/dev/null \
        | awk -F': ' 'tolower($1)=="server"{print $2; exit}' | tr -d '\r')"
    [ -n "$server" ] && printf '      Server header: %s\n' "$server"
    body="$(curl -s --max-time 5 "http://${probe}:${PROXY_PORT}/" 2>/dev/null | head -c 200)"
    printf '%s' "$body" | grep -qi 'prometheus' \
        && warn "  - the response looks like Prometheus itself, reached without the proxy."

    # (c) Is our site actually enabled?
    [ -f "$PROXY_SITE" ] || warn "  - CAUSE: ${PROXY_SITE} does not exist."
    [ -e "$PROXY_LINK" ] || warn "  - CAUSE: ${PROXY_LINK} symlink is missing; the site is not enabled."

    # (d) Does nginx.conf even include sites-enabled?
    if [ -f /etc/nginx/nginx.conf ]; then
        grep -qE '^[^#]*include[^;]*sites-enabled' /etc/nginx/nginx.conf \
            || warn "  - CAUSE: /etc/nginx/nginx.conf has no 'include .../sites-enabled/*' line, so ${PROXY_SITE} is never read."
    fi

    # (e) Does the running config really contain our auth directive?
    if command -v nginx >/dev/null 2>&1; then
        local loaded
        loaded="$(nginx -T 2>/dev/null || true)"
        if printf '%s' "$loaded" | grep -qF "auth_basic_user_file ${HTPASSWD_FILE}"; then
            ok "  - auth_basic_user_file IS present in the loaded config."
            warn "  - so the 200 came from a different listener on ${PROXY_PORT}, not this block."
        else
            warn "  - CAUSE: the loaded nginx config does not contain auth_basic_user_file ${HTPASSWD_FILE}."
            warn "    nginx is still running an older config. Try: systemctl restart nginx"
        fi
    fi

    # (f) The password file itself.
    if [ ! -f "$HTPASSWD_FILE" ]; then
        warn "  - CAUSE: ${HTPASSWD_FILE} is missing."
    elif [ ! -s "$HTPASSWD_FILE" ]; then
        warn "  - CAUSE: ${HTPASSWD_FILE} is empty."
    else
        printf '      %s: %s user(s): %s\n' "$HTPASSWD_FILE" \
            "$(wc -l < "$HTPASSWD_FILE" | tr -d ' ')" \
            "$(cut -d: -f1 "$HTPASSWD_FILE" | tr '\n' ' ')"
    fi

    printf '\n'
    warn "  Run these to confirm:"
    warn "    sudo ss -tulnp | grep ':${PROXY_PORT} '"
    warn "    sudo nginx -T | grep -A3 'listen.*${PROXY_PORT}'"
    warn "    sudo journalctl -u nginx -n 30 --no-pager"
    warn "  If another service owns ${PROXY_PORT}:  sudo ./${SCRIPT_NAME} --proxy-port 8081"
    printf '\n'
}

check_proxy_auth() {
    [ "$ENABLE_PROXY" -eq 1 ] || return 0
    command -v curl >/dev/null 2>&1 || return 0
    log "Confirming basic auth is enforced..."
    local code
    local probe="$PROXY_BIND"
    [ "$probe" = "0.0.0.0" ] && probe="127.0.0.1"
    code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 5 \
        "http://${probe}:${PROXY_PORT}/" 2>/dev/null || true)"
    case "$code" in
        401) ok "Unauthenticated request returns 401 — auth is active." ;;
        200) warn "Unauthenticated request returned 200 — auth is NOT being enforced."
             diagnose_proxy_auth "$probe"
             die  "Refusing to finish with an unprotected Prometheus." ;;
        *)   warn "Unexpected response ${code:-<none>} from the proxy." ;;
    esac
}

verify_prometheus_not_public() {
    # The whole security model rests on this: nginx asks for a password, but
    # Prometheus on ${PROMETHEUS_PORT} never does. If that port answers on a
    # non-loopback address, the password is decoration.
    [ "$ENABLE_PROXY" -eq 1 ] || return 0
    command -v curl >/dev/null 2>&1 || return 0
    log "Confirming Prometheus is not reachable without a password..."

    local ip code
    ip="$(hostname -I 2>/dev/null | awk '{print $1}')"
    [ -n "$ip" ] || { ok "No external address to test against."; return 0; }

    code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 5 \
        "http://${ip}:${PROMETHEUS_PORT}/-/ready" 2>/dev/null || true)"
    case "$code" in
        200) warn "Prometheus answers on ${ip}:${PROMETHEUS_PORT} with NO password."
             warn "Anyone who can reach this host can read every metric, bypassing nginx."
             die  "Re-run without --bind/--listen-all so Prometheus stays on 127.0.0.1." ;;
        *)   ok "Prometheus is loopback-only; ${ip}:${PROMETHEUS_PORT} is not reachable." ;;
    esac
}

print_tunnel_help() {
    local server_ip
    server_ip="$(hostname -I 2>/dev/null | awk '{print $1}')"
    cat <<EOF

  Access (nothing is exposed to the network):
    ssh -N -L ${PROXY_PORT}:127.0.0.1:${PROXY_PORT} <user>@${server_ip:-<this-server>}
    then open  http://127.0.0.1:${PROXY_PORT}   and log in as ${PROXY_USER}

    Ctrl-C ends the tunnel and releases the local port.

    Tunnel ${PROXY_PORT}, not ${PROMETHEUS_PORT}. Forwarding ${PROMETHEUS_PORT} reaches Prometheus
    directly and will NOT ask for a password -- that is the backend, not the
    login. If Prometheus opened without prompting you, this was why.

    Prefer no tunnel? Publish the authenticated proxy instead:
      sudo ./${SCRIPT_NAME} --proxy-bind 0.0.0.0
      then open  http://${server_ip:-<this-server>}:${PROXY_PORT}
      Restricting who can reach ${PROXY_PORT} is left to you -- this script does
      not touch the firewall.

    Add another login later:
      sudo htpasswd ${HTPASSWD_FILE} <newuser>      # no -c, it would wipe the file
EOF
}

# ===========================================================================
# Reachability — cheap check before the long install
# ===========================================================================

check_targets_reachable() {
    command -v curl >/dev/null 2>&1 || return 0
    log "Probing the monitored hosts (node exporter on ${NODE_PORT})..."
    local spec ip unreachable=0
    for spec in "${TARGETS[@]}"; do
        ip="$(target_ip "$spec")"
        if curl -fsS --max-time 4 "http://${ip}:${NODE_PORT}/metrics" >/dev/null 2>&1; then
            ok "${ip}:${NODE_PORT} answered."
        else
            warn "${ip}:${NODE_PORT} did not answer — the exporter may not be installed yet."
            is_private_ip "$ip" && warn "  ${ip} is a private address; this host must share its LAN or VPN."
            unreachable=1
        fi
    done
    [ "$unreachable" -eq 0 ] || warn "Install continues; those targets will show DOWN on /targets until they respond."
    return 0
}

# ===========================================================================
# Orchestration
# ===========================================================================

phase_prepare() {
    create_workdir
    check_proxy_port_free
    check_prometheus_port_free
    ask_targets
    ask_proxy_password
    check_targets_reachable
    update_server
    install_packages
    create_user
    detect_version
}

phase_install() {
    download_prometheus
    extract_prometheus
    create_directories
    install_binaries
    write_prometheus_config
    write_alert_rules
    set_permissions
    create_service
    validate_config
}

phase_proxy() {
    install_nginx
    create_htpasswd
    configure_proxy
}

phase_verify() {
    start_prometheus
    check_service
    check_port
    check_targets
    check_rules_loaded
    check_rule_metrics
    check_proxy_port
    check_proxy_auth
    verify_prometheus_not_public
    report_downloads
}

main() {
    init_colors
    parse_args "$@"
    check_root

    if [ "$UNINSTALL" -eq 1 ]; then
        do_uninstall
        exit 0
    fi

    banner "Prometheus Installation"
    phase_prepare
    phase_install
    phase_proxy
    phase_verify
    print_summary
}

# Allow `source ./install_prometheus.sh --source-only` to load the functions
# without running anything, for step-by-step debugging.
case "${1:-}" in
    --source-only) init_colors; SOURCE_ONLY=1 ;;
    *) main "$@" ;;
esac
